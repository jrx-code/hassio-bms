{# --------------------------------------------------- #}
{# BMS CALCULATION ENGINE v2.0                         #}
{# --------------------------------------------------- #}
{# Mode: PRECISION (Target 100% SoC at window end)     #}
{# Path: /config/custom_templates/bms.jinja            #}
{# --------------------------------------------------- #}
{# Replaces v1.2 "Safety First" with physics-based     #}
{# calculation: kwh_needed / charge_power = time.       #}
{# LiFePO4 sustains full CC rate up to ~97% SoC,       #}
{# 5-min buffer covers CV tail to 100%.                 #}
{# --------------------------------------------------- #}

{% macro calculate_start_time(target_hour_str, current_soc, capacity_kwh=20, charge_power_kw=10) %}

  {# --- Energy needed from current SoC to 100% --- #}
  {% set kwh_needed = ((100.0 - current_soc) / 100.0) * capacity_kwh %}

  {# --- Charge time: linear CC + 5 min CV buffer --- #}
  {% set minutes_needed = ((kwh_needed / charge_power_kw) * 60 + 5) | round(0, 'ceil') | int %}

  {# --- Target datetime (next occurrence) --- #}
  {% set target_dt = today_at(target_hour_str) %}
  {% if target_dt < now() %}
    {% set target_dt = target_dt + timedelta(days=1) %}
  {% endif %}

  {% if kwh_needed > 0.5 %}
    {{ (target_dt - timedelta(minutes=minutes_needed)).isoformat() }}
  {% else %}
    {# Less than 0.5 kWh needed — skip, return tomorrow to prevent trigger #}
    {{ (target_dt + timedelta(days=1)).isoformat() }}
  {% endif %}

{% endmacro %}
